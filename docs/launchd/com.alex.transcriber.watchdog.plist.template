<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Watchdog agent template (ADR 0010) — install alongside the daemon:

      cp <template> ~/Library/LaunchAgents/com.alex.transcriber.watchdog.plist
      launchctl bootstrap gui/501 ~/Library/LaunchAgents/com.alex.transcriber.watchdog.plist

    WD-1/WD-11: StartInterval 300, RunAtLoad, and NO KeepAlive — KeepAlive on a
    run-once script is an instant infinite loop. Worst-case detection latency:
    interval + staleness threshold ≈ 10 minutes.

    The watchdog runs under /usr/bin/python3 — the one interpreter Homebrew
    cannot break — via health_check.py (stdlib-only). Every subprocess gets a
    timeout and an absolute path (WD-7/WD-8). Cross-invocation state lives in
    ~/.superwhisper_transcriber_watchdog.json (WD-3); escalation notifications
    share the ES-3 cooldown stored in that file. A pause sentinel
    (~/.superwhisper_transcriber_watchdog.pause) makes the watchdog exit 0
    without acting (WD-10) — place it during any manual bootout/bootstrap.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alex.transcriber.watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__REPO__/health_check.py</string>
        <string>--heal</string>
        <string>--heartbeat</string>
        <string>__HOME__/.superwhisper_transcriber_heartbeat.json</string>
        <string>--state</string>
        <string>__HOME__/.superwhisper_transcriber_watchdog.json</string>
        <string>--label</string>
        <string>com.alex.transcriber</string>
        <string>--self-label</string>
        <string>com.alex.transcriber.watchdog</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/superwhisper-transcriber/watchdog.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/superwhisper-transcriber/watchdog.log</string>
</dict>
</plist>