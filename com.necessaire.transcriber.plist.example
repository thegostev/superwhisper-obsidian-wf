<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent template for the auto-transcription daemon.

  Setup:
    1. Replace every /ABSOLUTE/PATH/TO/superwhisper-obsidian-wf below with the
       real absolute path to your clone (run `pwd` inside the repo).
    2. Copy this file (drop the .example suffix) into ~/Library/LaunchAgents/:
         cp com.necessaire.transcriber.plist.example \
            ~/Library/LaunchAgents/com.necessaire.transcriber.plist
    3. Load it:
         launchctl load ~/Library/LaunchAgents/com.necessaire.transcriber.plist
       Unload with `launchctl unload <path>` before editing, then reload.

  The daemon writes to transcriber.log in the working directory, matching
  run_transcriber.sh. KeepAlive restarts it if it exits; RunAtLoad starts it
  at login.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.necessaire.transcriber</string>

    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/superwhisper-obsidian-wf/venv/bin/python3</string>
        <string>/ABSOLUTE/PATH/TO/superwhisper-obsidian-wf/auto_transcribe.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/superwhisper-obsidian-wf</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/superwhisper-obsidian-wf/transcriber.log</string>

    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/superwhisper-obsidian-wf/transcriber.log</string>

    <!-- Mirrors run_transcriber.sh: XetHub download protocol is incompatible
         with the Python 3.9 threading model used here. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HF_HUB_DISABLE_XET</key>
        <string>1</string>
    </dict>
</dict>
</plist>
