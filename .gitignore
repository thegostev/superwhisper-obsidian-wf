# ── Machine-specific / personal (the "locations" pattern) ───────────────
locations/
config.yaml
*.log
logs/
*.plist
.env
.env.*

# ── State (contains processed file paths) ───────────────────────────────
*.state.json
state.json
.superwhisper_transcriber_state.json
.meeting_transcriber_state.json
.transcriber.pid

# ── Python ──────────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# ── Test-generated config (regenerated by tests/conftest.py each run) ───
tests/_test_config.yaml

# ── Utility scripts (personal one-off tools) ────────────────────────────
utils/

# ── Backup files ────────────────────────────────────────────────────────
*.backup
*.py.backup

# ── Editor / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
.AppleDouble
.LSOverride